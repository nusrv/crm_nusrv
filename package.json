{
  "name": "customer-subscription-lifecycle-cp",
  "version": "0.1.0",
  "private": true,
  "description": "Customer Subscription Lifecycle Control Panel",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @cp/api\" \"npm run dev -w @cp/web\"",
    "dev:api": "npm run dev -w @cp/api",
    "dev:web": "npm run dev -w @cp/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage -w @cp/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @cp/api",
    "db:migrate": "npm run db:migrate -w @cp/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @cp/api",
    "db:seed": "npm run db:seed -w @cp/api",
    "clean": "npm run clean --workspaces --if-present",
    "test:db:mariadb": "npm run test:db:mariadb -w @cp/api",
    "dev:worker": "npm run dev:worker -w @cp/api",
    "start:worker": "npm run start:worker -w @cp/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  }
}
