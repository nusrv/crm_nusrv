[Unit]
Description=Customer Lifecycle CP staging API
After=network-online.target mariadb.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_PLESK_SYSTEM_USER
Group=REPLACE_PLESK_SYSTEM_GROUP
WorkingDirectory=REPLACE_RELEASE_DIRECTORY
EnvironmentFile=REPLACE_PRIVATE_ENV_PATH
ExecStart=/opt/plesk/node/22/bin/node apps/api/dist/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=customer-cp-api-staging

[Install]
WantedBy=multi-user.target
