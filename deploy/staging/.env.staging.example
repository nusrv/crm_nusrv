NODE_ENV=production
API_PORT=3001
APP_URL=https://crm.nusrv.com
WEB_URL=https://crm.nusrv.com
API_URL=https://crm.nusrv.com
NEXT_PUBLIC_API_URL=https://crm.nusrv.com

# MariaDB 10.6+ dedicated staging database. URL-encode special characters.
DATABASE_URL=mysql://staging_user:REPLACE_ME@127.0.0.1:3306/customer_lifecycle_cp_staging

# Prefer private/local Redis. REDIS_URL may be used instead of the individual values.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=REPLACE_ME
REDIS_DB=0
REDIS_TLS=false

BUSINESS_TIMEZONE=Asia/Amman
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

CAPTCHA_PROVIDER=none

AI_ENABLED=false
FAWTARA_MODE=mock
SMTP_MODE=mock
PLESK_MODE=mock
SMARTERMAIL_MODE=mock
