NODE_ENV=development
API_PORT=3001
APP_URL=http://localhost:3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Prisma uses the mysql:// connector scheme for MariaDB. URL-encode special password characters.
# Replace these development values with the Plesk database host, name, user, and secret in production.
DATABASE_URL=mysql://cp_user:cp_password@localhost:3306/customer_lifecycle_cp
# Use REDIS_URL, or leave it blank and use the individual Redis settings below.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
BUSINESS_TIMEZONE=Asia/Amman

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ENCRYPTION_KEY_BASE64=replace-with-a-base64-encoded-32-byte-key

# Internal staff-only deployments use none. mock is non-production only.
# turnstile/recaptcha require CAPTCHA_SITE_KEY and CAPTCHA_SECRET.
CAPTCHA_PROVIDER=none
CAPTCHA_TEST_TOKEN=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

AI_ENABLED=false
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
FAWTARA_MODE=mock
SMTP_MODE=mock
PLESK_MODE=mock
SMARTERMAIL_MODE=mock

# Optional development-only initial administrator. Both values are required together.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
