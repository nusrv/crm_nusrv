# Copy this file to apps/api/.env on the staging server.
# The real apps/api/.env is ignored by Git and must never be committed.

NODE_ENV=production
API_PORT=3001
APP_URL=https://crm.nusrv.com
WEB_URL=https://crm.nusrv.com
API_URL=https://crm.nusrv.com

# Replace the masked password. URL-encode special characters in the real password.
DATABASE_URL=mysql://crm_nusrv:*************@127.0.0.1:3306/crm_nusrv

# Redis 7.4.11 is local to the staging server and currently has no supplied credentials.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

BUSINESS_TIMEZONE=Asia/Amman

# Replace both masked values with different random secrets of at least 32 characters.
JWT_ACCESS_SECRET=********************************
JWT_REFRESH_SECRET=**************************************
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Replace with a base64-encoded 32-byte key. Asterisks are intentionally not a valid key.
ENCRYPTION_KEY_BASE64=********************************************

CAPTCHA_PROVIDER=none

# Phase 3+ integrations remain disabled/locked.
AI_ENABLED=false
FAWTARA_MODE=mock
SMTP_MODE=mock
PLESK_MODE=mock
SMARTERMAIL_MODE=mock

# Included for consistency with the staging configuration; the API does not expose this value.
NEXT_PUBLIC_API_URL=https://crm.nusrv.com
