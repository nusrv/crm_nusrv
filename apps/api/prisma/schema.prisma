generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  engineType   = "client"
}

datasource db {
  provider = "mysql"
}

enum PaymentScope {
  LOCAL
  INTERNATIONAL
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  BIENNIAL
  CUSTOM
}

enum TechnicalConnectionType {
  PLESK
  SMARTERMAIL
  MANUAL
  FUTURE_API
}

enum IntegrationEnvironment {
  SANDBOX
  PRODUCTION
}

enum HealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNAVAILABLE
}

enum RenewalCaseStatus {
  UPCOMING
  REMINDER_CYCLE
  AWAITING_CUSTOMER
  HUMAN_REVIEW
  ACCEPTED
  INVOICE_DRAFT
  INVOICE_PENDING_PUBLICATION
  INVOICE_PUBLISHED
  COLLECTING
  PAYMENT_REPORTED
  PAYMENT_CONFIRMED
  FULFILLED
  REJECTED
  RETENTION
  DO_NOT_RENEW
  SUSPENSION_DUE
  SUSPENSION_PENDING_APPROVAL
  SUSPENSION_IN_PROGRESS
  SUSPENDED
  REACTIVATION_PENDING
  CLOSED
  ERROR
}

enum CustomerDecision {
  ACCEPTED
  REJECTED
  UNDECIDED
}

enum ActorType {
  USER
  SYSTEM
  AI
  INTEGRATION
}

enum MfaMethodType {
  TOTP
  WEBAUTHN
}

enum LegacyImportBatchStatus {
  STAGED
  IN_REVIEW
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum LegacyImportRowStatus {
  STAGED
  REQUIRES_MANUAL_REVIEW
  READY_FOR_APPROVAL
  APPROVED
  FAILED
  SKIPPED
}

enum LegacyValidationStatus {
  PENDING
  VALID
  INVALID
  AMBIGUOUS
}

enum LegacyCustomerResolution {
  CREATE_NEW
  ATTACH_EXISTING
  NOT_DUPLICATE
}

enum ReminderAudience {
  CUSTOMER
  INTERNAL
}

enum CommunicationOutboxStatus {
  QUEUED
  PROCESSING
  DELIVERED
  FAILED
  CANCELLED
}

enum RenewalDecisionOutcome {
  SKIPPED_HOLD
  SKIPPED_INELIGIBLE
  DUPLICATE_PREVENTED
}

enum PackageKind {
  STANDARD
  ADD_ON
  CUSTOM_TEMPLATE
}

enum PackageClassificationStatus {
  UNCLASSIFIED
  MATCHED_OFFICIAL
  CUSTOM
  MANUAL_REVIEW
}

enum CustomerContactRole {
  PRIMARY
  BILLING
  TECHNICAL
  MANAGEMENT
  OTHER
}

enum SubscriptionIdentifierType {
  DOMAIN
  HOSTNAME
  MAIL_DOMAIN
  SERVER_ACCOUNT
  OTHER
}

enum PhoneType {
  MOBILE
  LANDLINE
  FAX
  PHONE
}

enum ChannelVerificationStatus {
  UNVERIFIED
  VERIFIED
  INVALID
}

// Phase 3 Slice A — Mail & AI communication domain enums. Schema only; no SMTP/IMAP/LLM/worker
// code exists yet (see PHASES/PHASE_03_MAIL_AI.md). Exact approved values only — nothing invented.
enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageChannel {
  EMAIL
}

enum ThreadStatus {
  OPEN
  HUMAN_REVIEW
  RESOLVED
}

enum ClassificationStatus {
  PENDING
  CLASSIFIED
  HUMAN_REVIEW
  RESOLVED
  FAILED
}

// Exact allowed intents from 05_AI_LLM_MCP_STRATEGY.md's structured-output contract. Do not add or
// rename values without re-approving against that document.
enum AiIntent {
  ACCEPT_RENEWAL
  REJECT_RENEWAL
  REQUEST_INVOICE
  PAYMENT_REPORTED
  REQUEST_UPGRADE
  REQUEST_DOWNGRADE
  REQUEST_CLARIFICATION
  PRICE_DISPUTE
  COMPLAINT
  OTHER
  UNCLEAR
}

// Phase-3-scoped only (SMTP/IMAP/AI) — deliberately narrower than a future Phase 6/7 integration
// list (Plesk/SmarterMail/Fawtara), which belongs to those phases' own work, not this one.
enum IntegrationKind {
  SMTP
  IMAP
  AI
}

model BillingEntity {
  id                     String                @id @default(uuid()) @db.VarChar(36)
  name                   String
  code                   String                @unique
  customerCodePrefix     String                @unique @map("customer_code_prefix") @db.VarChar(10)
  paymentScope           PaymentScope          @map("payment_scope")
  legalName              String                @map("legal_name")
  taxNumber              String?               @map("tax_number")
  address                String?
  invoiceEmail           String?               @map("invoice_email")
  bankDetailsCiphertext  String?               @map("bank_details_ciphertext") @db.Text
  fawtaraConfigReference String?               @map("fawtara_config_reference")
  active                 Boolean               @default(true)
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  customers              Customer[]
  legacyImportRows       LegacyImportRow[]
  customerCodeSequence   CustomerCodeSequence?
  mailConfigurations     MailConfiguration[]

  @@map("billing_entities")
}

// One row per Billing Entity. `lastValue` only ever increments (never decremented, never reused
// on delete) — it is the sole source of truth for the next `customerCode` suffix under that
// entity. See CustomerCodeService for the concurrency-safe increment.
model CustomerCodeSequence {
  billingEntityId String        @id @map("billing_entity_id") @db.VarChar(36)
  lastValue       Int           @default(0) @map("last_value")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  billingEntity   BillingEntity @relation(fields: [billingEntityId], references: [id], onDelete: Restrict)

  @@map("customer_code_sequences")
}

model Customer {
  id                       String                    @id @default(uuid()) @db.VarChar(36)
  billingEntityId          String                    @map("billing_entity_id") @db.VarChar(36)
  customerCode             String                    @unique @map("customer_code")
  nameEn                   String?                   @map("name_en")
  nameAr                   String?                   @map("name_ar")
  contactName              String?                   @map("contact_name")
  primaryEmail             String                    @map("primary_email")
  secondaryEmail           String?                   @map("secondary_email")
  phone                    String?
  address                  String?
  country                  String?
  taxNumber                String?                   @map("tax_number")
  preferredLanguage        String                    @default("en") @map("preferred_language")
  status                   CustomerStatus            @default(ACTIVE)
  sourceLegacyReference    String?                   @map("source_legacy_reference")
  sourceSequence           Int?                      @map("source_sequence")
  notes                    String?                   @db.Text
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  billingEntity            BillingEntity             @relation(fields: [billingEntityId], references: [id], onDelete: Restrict)
  subscriptions            Subscription[]
  contacts                 CustomerContact[]
  emailAddresses           CustomerEmailAddress[]
  phoneNumbers             CustomerPhoneNumber[]
  communicationOutbox      CommunicationOutbox[]
  legacyCandidateRows      LegacyImportRow[]         @relation("LegacyCandidateCustomer")
  legacyApprovedRows       LegacyImportRow[]         @relation("LegacyApprovedCustomer")
  subscriptionCodeSequence SubscriptionCodeSequence?
  communicationThreads     CommunicationThread[]
  emailMessages            EmailMessage[]

  @@index([billingEntityId])
  @@index([nameEn])
  @@index([nameAr])
  @@index([primaryEmail])
  @@index([sourceSequence])
  @@map("customers")
}

model CustomerContact {
  id                    String                 @id @default(uuid()) @db.VarChar(36)
  customerId            String                 @map("customer_id") @db.VarChar(36)
  role                  CustomerContactRole    @default(OTHER)
  name                  String?                @db.VarChar(191)
  email                 String?                @db.VarChar(320)
  phone                 String?                @db.VarChar(80)
  primary               Boolean                @default(false)
  active                Boolean                @default(true)
  sourceLegacyReference String?                @map("source_legacy_reference") @db.VarChar(500)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  emailAddresses        CustomerEmailAddress[]
  phoneNumbers          CustomerPhoneNumber[]

  @@index([customerId, active])
  @@index([email])
  @@map("customer_contacts")
}

model CustomerEmailAddress {
  id                    String                    @id @default(uuid()) @db.VarChar(36)
  customerId            String                    @map("customer_id") @db.VarChar(36)
  contactId             String?                   @map("contact_id") @db.VarChar(36)
  email                 String                    @db.VarChar(320)
  holderName            String?                   @map("holder_name") @db.VarChar(191)
  role                  CustomerContactRole       @default(OTHER)
  label                 String?                   @db.VarChar(100)
  primary               Boolean                   @default(false)
  active                Boolean                   @default(true)
  verificationStatus    ChannelVerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt            DateTime?                 @map("verified_at")
  sourceLegacyReference String?                   @map("source_legacy_reference") @db.VarChar(500)
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  customer              Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contact               CustomerContact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([customerId, email], map: "customer_email_addresses_customer_email_key")
  @@index([customerId, active])
  @@index([contactId])
  @@index([email])
  @@map("customer_email_addresses")
}

model CustomerPhoneNumber {
  id                    String                    @id @default(uuid()) @db.VarChar(36)
  customerId            String                    @map("customer_id") @db.VarChar(36)
  contactId             String?                   @map("contact_id") @db.VarChar(36)
  phoneNumber           String                    @map("phone_number") @db.VarChar(20)
  countryCallingCode    String                    @map("country_calling_code") @db.VarChar(5)
  phoneType             PhoneType                 @default(PHONE) @map("phone_type")
  rawValue              String?                   @map("raw_value") @db.VarChar(100)
  country               String?                   @db.VarChar(100)
  areaOrOperatorCode    String?                   @map("area_or_operator_code") @db.VarChar(20)
  subscriberNumber      String?                   @map("subscriber_number") @db.VarChar(40)
  extension             String?                   @db.VarChar(20)
  holderName            String?                   @map("holder_name") @db.VarChar(191)
  role                  CustomerContactRole       @default(OTHER)
  label                 String?                   @db.VarChar(100)
  primary               Boolean                   @default(false)
  active                Boolean                   @default(true)
  verificationStatus    ChannelVerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt            DateTime?                 @map("verified_at")
  metadata              Json?
  sourceLegacyReference String?                   @map("source_legacy_reference") @db.VarChar(500)
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  customer              Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contact               CustomerContact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([customerId, phoneNumber], map: "customer_phone_numbers_customer_phone_key")
  @@index([customerId, active])
  @@index([contactId])
  @@index([phoneNumber])
  @@map("customer_phone_numbers")
}

model ServiceType {
  id                   String           @id @default(uuid()) @db.VarChar(36)
  code                 String           @unique
  name                 String
  description          String?
  active               Boolean          @default(true)
  defaultSuspendPolicy Json?            @map("default_suspend_policy")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  subscriptions        Subscription[]
  packages             ServicePackage[]

  @@map("service_types")
}

model ServicePackage {
  id              String               @id @default(uuid()) @db.VarChar(36)
  serviceTypeId   String               @map("service_type_id") @db.VarChar(36)
  code            String               @unique @db.VarChar(100)
  name            String               @db.VarChar(191)
  kind            PackageKind          @default(STANDARD)
  description     String?              @db.Text
  specifications  Json?
  sourceReference String?              @map("source_reference") @db.VarChar(500)
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  serviceType     ServiceType          @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  terms           ServicePackageTerm[]
  subscriptions   Subscription[]

  @@index([serviceTypeId, active])
  @@map("service_packages")
}

model ServicePackageTerm {
  id                   String         @id @default(uuid()) @db.VarChar(36)
  servicePackageId     String         @map("service_package_id") @db.VarChar(36)
  termMonths           Int            @map("term_months")
  currency             String         @db.VarChar(3)
  standardSellingPrice Decimal        @map("standard_selling_price") @db.Decimal(14, 3)
  standardSupplierCost Decimal?       @map("standard_supplier_cost") @db.Decimal(14, 3)
  active               Boolean        @default(true)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  servicePackage       ServicePackage @relation(fields: [servicePackageId], references: [id], onDelete: Restrict)

  @@unique([servicePackageId, termMonths, currency], map: "service_package_terms_package_term_currency_key")
  @@index([active])
  @@map("service_package_terms")
}

model Currency {
  code          String         @id @db.VarChar(3)
  name          String         @db.VarChar(100)
  rateToJod     Decimal?       @map("rate_to_jod") @db.Decimal(18, 9)
  effectiveDate DateTime?      @map("effective_date") @db.Date
  active        Boolean        @default(false)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  subscriptions Subscription[]

  @@index([active, code])
  @@map("currencies")
}

// One row per Customer. `lastValue` only ever increments (never decremented, never reused on
// delete) — it is the sole source of truth for the next `subscriptionCode` suffix under that
// customer. See SubscriptionCodeService for the concurrency-safe increment.
model SubscriptionCodeSequence {
  customerId String   @id @map("customer_id") @db.VarChar(36)
  lastValue  Int      @default(0) @map("last_value")
  updatedAt  DateTime @updatedAt @map("updated_at")
  // Cascade, not Restrict: this row is internal sequence state owned entirely by the Customer and
  // has no value once the Customer is gone. `CustomersService.deleteCustomer()` explicitly deletes
  // the customer's subscriptions and other dependents but does not (and should not need to) know
  // about this table — a Restrict here would break that existing, already-audited delete flow for
  // every customer that has ever had a subscription. Deleting an individual Subscription never
  // touches this row at all (no FK between Subscription and SubscriptionCodeSequence), so the
  // sequence's `lastValue` is unaffected by anything except a full Customer deletion.
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("subscription_code_sequences")
}

model Subscription {
  id                            String                        @id @default(uuid()) @db.VarChar(36)
  customerId                    String                        @map("customer_id") @db.VarChar(36)
  serviceTypeId                 String                        @map("service_type_id") @db.VarChar(36)
  servicePackageId              String?                       @map("service_package_id") @db.VarChar(36)
  subscriptionCode              String                        @unique @map("subscription_code")
  name                          String
  description                   String?
  startDate                     DateTime                      @map("start_date") @db.Date
  renewalDate                   DateTime                      @map("renewal_date") @db.Date
  currentTermEndDate            DateTime?                     @map("current_term_end_date") @db.Date
  billingFrequency              BillingFrequency              @map("billing_frequency")
  renewalIntervalMonths         Int?                          @map("renewal_interval_months")
  contractTermMonths            Int?                          @map("contract_term_months")
  supplierCost                  Decimal?                      @map("supplier_cost") @db.Decimal(14, 3)
  sellingPrice                  Decimal                       @map("selling_price") @db.Decimal(14, 3)
  currency                      String                        @db.VarChar(3)
  exchangeRateToJod             Decimal?                      @map("exchange_rate_to_jod") @db.Decimal(18, 9)
  sellingPriceJod               Decimal?                      @map("selling_price_jod") @db.Decimal(14, 3)
  exchangeRateEffectiveDate     DateTime?                     @map("exchange_rate_effective_date") @db.Date
  providerAutoRenews            Boolean                       @default(true) @map("provider_auto_renews")
  status                        SubscriptionStatus            @default(ACTIVE)
  graceHours                    Int                           @default(24) @map("grace_hours")
  sourceLegacyReference         String?                       @map("source_legacy_reference")
  sourceSequence                Int?                          @map("source_sequence")
  sourceRegistration            String?                       @map("source_registration") @db.VarChar(191)
  paidLabel                     String?                       @map("paid_label") @db.VarChar(50)
  packageNameSnapshot           String?                       @map("package_name_snapshot") @db.VarChar(191)
  packageSpecificationsSnapshot Json?                         @map("package_specifications_snapshot")
  customPackage                 Boolean                       @default(false) @map("custom_package")
  classificationStatus          PackageClassificationStatus   @default(UNCLASSIFIED) @map("classification_status")
  classificationEvidence        Json?                         @map("classification_evidence")
  priceOverrideReason           String?                       @map("price_override_reason") @db.Text
  notes                         String?                       @db.Text
  createdAt                     DateTime                      @default(now()) @map("created_at")
  updatedAt                     DateTime                      @updatedAt @map("updated_at")
  customer                      Customer                      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currencyDefinition            Currency                      @relation(fields: [currency], references: [code], onDelete: Restrict, onUpdate: Cascade)
  serviceType                   ServiceType                   @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  servicePackage                ServicePackage?               @relation(fields: [servicePackageId], references: [id], onDelete: Restrict)
  identifiers                   SubscriptionIdentifier[]
  connections                   SubscriptionConnection[]
  renewalCases                  RenewalCase[]
  communicationOutbox           CommunicationOutbox[]
  legacyImportSource            LegacyImportSubscriptionLink?

  @@index([customerId])
  @@index([serviceTypeId])
  @@index([servicePackageId])
  @@index([renewalDate, status])
  @@index([sourceSequence])
  @@map("subscriptions")
}

model SubscriptionIdentifier {
  id             String                     @id @default(uuid()) @db.VarChar(36)
  subscriptionId String                     @map("subscription_id") @db.VarChar(36)
  type           SubscriptionIdentifierType
  value          String                     @db.VarChar(500)
  label          String?                    @db.VarChar(191)
  active         Boolean                    @default(true)
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  subscription   Subscription               @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, type, value])
  @@index([value])
  @@map("subscription_identifiers")
}

model TechnicalConnection {
  id                    String                   @id @default(uuid()) @db.VarChar(36)
  code                  String                   @unique
  name                  String
  type                  TechnicalConnectionType
  endpoint              String?                  @db.VarChar(500)
  credentialsCiphertext String?                  @map("credentials_ciphertext") @db.Text
  enabled               Boolean                  @default(true)
  environment           IntegrationEnvironment   @default(SANDBOX)
  capabilities          Json?
  lastHealthStatus      HealthStatus             @default(UNKNOWN) @map("last_health_status")
  lastHealthCheckedAt   DateTime?                @map("last_health_checked_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  subscriptions         SubscriptionConnection[]

  @@map("technical_connections")
}

model SubscriptionConnection {
  id                    String              @id @default(uuid()) @db.VarChar(36)
  subscriptionId        String              @map("subscription_id") @db.VarChar(36)
  technicalConnectionId String              @map("technical_connection_id") @db.VarChar(36)
  remoteIdentifier      String              @map("remote_identifier")
  actionProfile         Json?               @map("action_profile")
  metadata              Json?
  active                Boolean             @default(true)
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  subscription          Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  technicalConnection   TechnicalConnection @relation(fields: [technicalConnectionId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, technicalConnectionId, remoteIdentifier])
  @@index([technicalConnectionId])
  @@map("subscription_connections")
}

model RenewalCase {
  id                    String                      @id @default(uuid()) @db.VarChar(36)
  subscriptionId        String                      @map("subscription_id") @db.VarChar(36)
  cycleStartDate        DateTime                    @map("cycle_start_date") @db.Date
  dueDate               DateTime                    @map("due_date") @db.Date
  status                RenewalCaseStatus           @default(UPCOMING)
  customerDecision      CustomerDecision            @default(UNDECIDED) @map("customer_decision")
  acceptedAt            DateTime?                   @map("accepted_at")
  rejectedAt            DateTime?                   @map("rejected_at")
  doNotRenewAt          DateTime?                   @map("do_not_renew_at")
  suspensionDueAt       DateTime?                   @map("suspension_due_at")
  fulfilledAt           DateTime?                   @map("fulfilled_at")
  closedAt              DateTime?                   @map("closed_at")
  assignedUserId        String?                     @map("assigned_user_id") @db.VarChar(36)
  lastCustomerContactAt DateTime?                   @map("last_customer_contact_at")
  lastEvaluatedAt       DateTime?                   @map("last_evaluated_at")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  subscription          Subscription                @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  assignedUser          User?                       @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  holds                 RenewalHold[]
  communicationOutbox   CommunicationOutbox[]
  evaluationDecisions   RenewalEvaluationDecision[]
  communicationThread   CommunicationThread?
  emailMessages         EmailMessage[]

  @@unique([subscriptionId, dueDate])
  @@index([status, dueDate])
  @@index([assignedUserId])
  @@map("renewal_cases")
}

model Role {
  id          String     @id @default(uuid()) @db.VarChar(36)
  code        String     @unique
  name        String
  description String?
  permissions Json       @default("[]")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  users       UserRole[]

  @@map("roles")
}

model User {
  id                    String                 @id @default(uuid()) @db.VarChar(36)
  email                 String                 @unique
  displayName           String                 @map("display_name")
  passwordHash          String                 @map("password_hash")
  active                Boolean                @default(true)
  failedAttempts        Int                    @default(0) @map("failed_attempts")
  lockedUntil           DateTime?              @map("locked_until")
  mfaEnabled            Boolean                @default(false) @map("mfa_enabled")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  roles                 UserRole[]
  sessions              AuthSession[]
  mfaMethods            UserMfaMethod[]
  renewalCases          RenewalCase[]
  importBatches         LegacyImportBatch[]    @relation("LegacyImportBatchCreator")
  approvedImportRows    LegacyImportRow[]      @relation("LegacyImportRowApprover")
  createdRenewalHolds   RenewalHold[]          @relation("RenewalHoldCreator")
  releasedRenewalHolds  RenewalHold[]          @relation("RenewalHoldReleaser")
  classificationReviews ClassificationReview[]

  @@map("users")
}

model UserRole {
  userId     String   @map("user_id") @db.VarChar(36)
  roleId     String   @map("role_id") @db.VarChar(36)
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.VarChar(36)
  userId           String    @map("user_id") @db.VarChar(36)
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model UserMfaMethod {
  id               String        @id @default(uuid()) @db.VarChar(36)
  userId           String        @map("user_id") @db.VarChar(36)
  type             MfaMethodType
  label            String?
  secretCiphertext String?       @map("secret_ciphertext") @db.Text
  credentialData   Json?         @map("credential_data")
  verifiedAt       DateTime?     @map("verified_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_mfa_methods")
}

